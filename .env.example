# Server Configuration
PORT=3000
NODE_ENV=development

# Application URL (Used for webhooks, redirects, and CORS)
APP_URL="http://localhost:3000"

# Stripe Thailand Payment Gateway
# Obtain these from your Stripe Dashboard: https://dashboard.stripe.com/apikeys
# WARNING: Never commit real 'sk_live_...' secret keys to GitHub!
STRIPE_PUBLISHABLE_KEY="pk_test_your_stripe_publishable_key"
STRIPE_SECRET_KEY="sk_test_your_stripe_secret_key"
STRIPE_WEBHOOK_SECRET="whsec_your_webhook_signing_secret"

# Merchant PromptPay Phone/ID (Fallback for direct peer transfers if enabled)
PROMPTPAY_NUMBER="0637659195"

# Gemini AI (Optional - for intelligent support / verification)
GEMINI_API_KEY=""
